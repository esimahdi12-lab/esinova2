{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esinova2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9b3bfbe4-547c-45be-84f0-b15d1e715e1d","database_name": "esinova2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0b311adbe09f46a4aa308657b03cab3b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
